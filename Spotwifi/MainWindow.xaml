<Window x:Class="Spotwifi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spotwifi"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- 0: Thanh công cụ -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Bảng danh sách nhạc -->
            <RowDefinition Height="*"/>
            <!-- 2: Cụm Player điều khiển -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. THANH CÔNG CỤ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="📂 Chọn thư mục nhạc..." 
                    Padding="12,6" Height="34" FontSize="13"
                    Click="BtnOpenFolder_Click" Cursor="Hand"/>

            <TextBox x:Name="TxtSearch" Grid.Column="1" Margin="15,0,0,0" Height="34"
                     VerticalContentAlignment="Center" Padding="8,0" FontSize="13"
                     TextChanged="TxtSearch_TextChanged"/>
        </Grid>

        <!-- 1. BẢNG DANH SÁCH BÀI HÁT -->
        <DataGrid x:Name="DgSongs" Grid.Row="1"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="44"
                  Background="White"
                  BorderBrush="#E0E0E0"
                  MouseDoubleClick="DgSongs_MouseDoubleClick">
            <DataGrid.Columns>
                <!-- Cột hiển thị ảnh bìa -->
                <DataGridTemplateColumn Header="Bìa" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" ClipToBounds="True" Width="36" Height="36" Background="#E9ECEF">
                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Tên bài hát" Binding="{Binding Title}" Width="2*" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Nghệ sĩ" Binding="{Binding Artist}" Width="1.5*"/>
                <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="1.2*"/>
                <DataGridTextColumn Header="Thời lượng" Binding="{Binding DurationDisplay}" Width="85"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 2. CỤM PLAYER PHÍA DƯỚI -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" 
                CornerRadius="8" Padding="15,10" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Thanh tua tiến độ -->
                    <RowDefinition Height="Auto"/>
                    <!-- Cụm thông tin & nút bấm -->
                </Grid.RowDefinitions>

                <!-- Thanh tua bài hát (Seek bar) -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtCurrentTime" Text="00:00" VerticalAlignment="Center" FontSize="11" Foreground="#6C757D"/>
                    <Slider x:Name="SliderProgress" Grid.Column="1" Minimum="0" Maximum="100" 
                            Margin="8,0" VerticalAlignment="Center" Cursor="Hand"
                            PreviewMouseDown="Slider_PreviewMouseDown"
                            ValueChanged="SliderProgress_ValueChanged"/>
                    <TextBlock x:Name="TxtTotalTime" Grid.Column="2" Text="00:00" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#6C757D"/>
                </Grid>

                <!-- Cụm điều khiển chính -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <!-- Thông tin bài đang nghe -->
                        <ColumnDefinition Width="2*"/>
                        <!-- Nút bấm điều khiển -->
                        <ColumnDefinition Width="1.5*"/>
                        <!-- Âm lượng -->
                    </Grid.ColumnDefinitions>

                    <!-- Thông tin bài đang phát -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCurrentTitle" Text="Chưa chọn bài hát" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtCurrentArtist" Text="—" FontSize="11" Foreground="#6C757D" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Cụm nút Play / Pause / Chuyển bài -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="⏮" Width="36" Height="32" Margin="3" FontSize="14" Click="BtnPrev_Click"/>
                        <Button x:Name="BtnPlayPause" Content="▶" Width="48" Height="36" Margin="6,0" FontSize="16" FontWeight="Bold" Click="BtnPlayPause_Click"/>
                        <Button Content="⏭" Width="36" Height="32" Margin="3" FontSize="14" Click="BtnNext_Click"/>
                    </StackPanel>

                    <!-- Cụm âm lượng -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                        <Slider x:Name="SliderVolume" Width="100" Minimum="0" Maximum="1" Value="0.7" 
                                VerticalAlignment="Center" Cursor="Hand" ValueChanged="SliderVolume_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
